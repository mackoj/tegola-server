# tegola-server and Caddy settings. Copy to .env (git-ignored) and fill in; never commit the filled-in file.
# Every "OWNER" value is an answer from docs/PLAN.md §9; docs/DEPLOY.md says where each one comes from.

# --- Server ---------------------------------------------------------------------------------------------------------
# OWNER (PLAN §9 q4): your Apple Team ID, then the bundle id. The server refuses to start without a valid one.
TEGOLA_APP_ID=ABCDE12345.fr.macko.tegola
# production: only production App Attest keys, debug tokens refused. development: TestFlight/Xcode builds too.
TEGOLA_ENVIRONMENT=production
# Development only, at least 32 characters (openssl rand -hex 24). Must stay empty in production.
TEGOLA_DEBUG_TOKEN=
LOG_LEVEL=info

# --- Database (Postgres, D-17) ---------------------------------------------------------------------------------------
# The password of the stack's Postgres, set once at its first start. Hex only, so it needs no escaping in the URL:
#   openssl rand -hex 32
# Outside this stack (a managed Postgres), drop the postgres service and set TEGOLA_DATABASE_URL on the server instead,
# with sslmode=verify-full.
TEGOLA_DB_PASSWORD=

# --- TLS front (Caddy) ----------------------------------------------------------------------------------------------
# OWNER (PLAN §9 q2): the API's host name, pointing (DNS A/AAAA) at this machine. `localhost` for a local rehearsal
# (Caddy then uses its own CA).
TEGOLA_DOMAIN=localhost

# --- Lookup sources (M3, D-22) ---------------------------------------------------------------------------------------
# A source is on when its variables are set; leave a pair empty to keep that source off (its type answers "no match").
# Setting half a pair stops the server. Values: no spaces, at most 256 characters.
# Music, MusicBrainz: no key, but its terms ask for a contact in the User-Agent (a URL or an e-mail address).
TEGOLA_MUSICBRAINZ_CONTACT=
# Video games, IGDB: a Twitch application's client id and secret (dev.twitch.tv/console/apps).
TEGOLA_IGDB_CLIENT_ID=
TEGOLA_IGDB_CLIENT_SECRET=
# Video games, ScreenScraper: a developer account (screenscraper.fr, "API" forum). A member account is optional and
# raises the quota.
TEGOLA_SCREENSCRAPER_DEV_ID=
TEGOLA_SCREENSCRAPER_DEV_PASSWORD=
TEGOLA_SCREENSCRAPER_USER=
TEGOLA_SCREENSCRAPER_PASSWORD=
# Board games, BoardGameGeek: an XML API application's bearer token (boardgamegeek.com/applications).
TEGOLA_BGG_TOKEN=
